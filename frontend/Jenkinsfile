pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'frontend/target/*.jar', fingerprint: true
            }
        }
    }
}
