pipeline {
    agent any
    stages {
        stage('Diagnostic') {
            steps {
                sh 'node -v'
                sh 'npm -v'
            }
        }
        stage('Install') {
            steps {
                dir('frontend') {
                    sh 'npm ci || npm install'
                }
            }
        }
        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'frontend/dist/**', allowEmptyArchive: true
            }
        }
    }
}
